# Public origin used for canonical URLs, Open Graph tags, robots.txt and the
# sitemap. Set this to the real domain in your hosting provider before going
# live; without it those URLs fall back to https://homecalc.net.
#
# Read at build time. Public by definition (it is inlined into the HTML), so
# it holds no secret. Optional for local development and the test suite.
NEXT_PUBLIC_SITE_URL=https://homecalc.net

# Google AdSense publisher id, issued by AdSense after you add the site.
# Format: ca-pub-0000000000000000
# While this is unset the ad tag is not loaded and /ads.txt stays empty, so a
# half-configured deployment can never publish a wrong publisher id.
NEXT_PUBLIC_ADSENSE_ID=

# Google Search Console HTML-tag verification token — the `content` value of
# the <meta name="google-site-verification"> tag. Leave empty if ownership was
# verified by DNS record instead.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
